<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Connexion</title>
    </head>
    <body>
        <h1>Connexion au site M2L Basket</h1>

        {% if error %}
            <p style="color: red;">
                Adresse e-mail ou mot de passe incorrect.
            </p>
        {% endif %}

        <form method="post">
            <div>
                <label for="email">Adresse e-mail :</label>
                <input 
                    type="email"
                    id="email"
                    name="email"
                    value="{{ last_username }}"
                    required
                    autofocus
                >
            </div>

            <div>
                <label for="password">Mot de passe :</label>
                <input 
                    type="password"
                    id="password"
                    name="password"
                    required
                >
            </div>

            <input  
                type="hidden"
                name="_csrf_token"
                value="{{ csrf_token('authenticate') }}"
            >

            <button type="submit">Se connecter</button>
        </form>

    </body>
</html>
